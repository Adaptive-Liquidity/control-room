# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aeon_marketing"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here"

# Signup gate — when unset/false, only ADMIN (settings.manage) can create users.
# When true, unauthenticated signup is allowed but always creates VIEWER accounts.
ALLOW_PUBLIC_SIGNUP="false"

# n8n bridge (required for /api/integrations/n8n/* and resume delivery)
# HMAC secrets for ingress (drafts + publish-receipt) and resume callbacks (separate).
N8N_INGRESS_SECRET="replace-with-long-random-string"
N8N_RESUME_SECRET="replace-with-different-long-random-string"
# 32-byte key as 64-char hex OR standard base64; other values are sha256-derived.
N8N_BRIDGE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Protects /api/cron/outbox-drain (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="replace-with-long-random-string"

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"

# Redis (for BullMQ queues)
REDIS_URL="redis://localhost:6379"

# OpenAI (for Creator Agent)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# Twitter API
TWITTER_API_KEY="..."
TWITTER_API_SECRET="..."
TWITTER_ACCESS_TOKEN="..."
TWITTER_ACCESS_SECRET="..."

# LinkedIn API
LINKEDIN_CLIENT_ID="..."
LINKEDIN_CLIENT_SECRET="..."
LINKEDIN_ACCESS_TOKEN="..."

# Discord Bot
DISCORD_BOT_TOKEN="..."
DISCORD_GUILD_ID="..."

# Mailchimp
MAILCHIMP_API_KEY="..."
MAILCHIMP_SERVER_PREFIX="us1"
MAILCHIMP_LIST_ID="..."

# Pusher (real-time)
PUSHER_APP_ID="..."
PUSHER_KEY="..."
PUSHER_SECRET="..."
PUSHER_CLUSTER="us2"

# Resend (email)
RESEND_API_KEY="re_..."
