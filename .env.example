# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/control_room?sslmode=require"

# NextAuth (required)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here"

# Signup gate — when unset/false, only ADMIN (settings.manage) can create users.
# When true, unauthenticated signup is allowed but always creates VIEWER accounts.
ALLOW_PUBLIC_SIGNUP="false"

# Staging/prod first admin (used only by `npm run db:bootstrap-admin`)
# Do not commit real values. Local E2E uses `npm run db:ensure-dev-users` instead.
# BOOTSTRAP_ADMIN_EMAIL="ops@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="replace-with-strong-password-min-12-chars"
# BOOTSTRAP_ADMIN_NAME="Ops Admin"

# n8n bridge (required for /api/integrations/n8n/* and resume delivery)
# HMAC secrets for ingress (drafts + publish-receipt + agent-runs + metrics) and resume callbacks (separate).
N8N_INGRESS_SECRET="replace-with-long-random-string"
N8N_RESUME_SECRET="replace-with-different-long-random-string"
# 32-byte key as 64-char hex OR standard base64; other values are sha256-derived.
N8N_BRIDGE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Protects /api/cron/outbox-drain (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="replace-with-long-random-string"

# Studio Generate with AI (optional until Studio rewrite is used)
# Distinct secret from N8N_INGRESS_SECRET. Sent as HMAC and X-AEON-Generate-Auth.
# Attach n8n Header Auth on the webhook: header X-AEON-Generate-Auth = N8N_GENERATE_SECRET.
# N8N_GENERATE_WEBHOOK_URL="https://your-n8n.example/webhook/aeon-studio-generate"
# N8N_GENERATE_SECRET="replace-with-long-random-string-not-the-ingress-secret"

# Firebase / GCS (signed asset upload URLs via firebase-admin) — optional until assets needed
# NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
# NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef"
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
# FIREBASE_ADMIN_PROJECT_ID="your-project-id"
# Optional override; defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
# FIREBASE_STORAGE_BUCKET="your-project.appspot.com"

# Pusher (real-time) — optional; UI falls back to React Query polling
# PUSHER_APP_ID="..."
# PUSHER_KEY="..."
# PUSHER_SECRET="..."
# PUSHER_CLUSTER="us2"
# NEXT_PUBLIC_PUSHER_KEY="..."
# NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# Optional email (Resend) — unused by core approval bridge
# RESEND_API_KEY="re_..."

# Platform APIs, LLM providers, Mailchimp, Discord, X/Twitter, LinkedIn, Redis/BullMQ:
# live in n8n credentials — not required by Control Room. See docs/n8n-bridge.md.
