generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  avatar        String?
  role          UserRole  @default(EDITOR)
  permissions   String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  isActive      Boolean   @default(true)

  contents      Content[]
  approvals     Approval[]
  campaigns     Campaign[]
  activities    ActivityLog[]
  revisions     ContentRevision[]

  @@map("users")
}

model Content {
  id              String        @id @default(cuid())
  title           String
  body            String        @db.Text
  type            ContentType
  status          ContentStatus @default(DRAFT)
  channel         Channel
  campaignId      String?

  // Origin / n8n bridge metadata
  origin            ContentOrigin    @default(MANUAL)
  externalDraftId   String?          @unique
  n8nWorkflowId     String?
  n8nExecutionId    String?
  currentRevisionId String?
  riskTier          ContentRiskTier  @default(MEDIUM)

  // Guardian scoring (denormalized mirror of current revision)
  guardianScore   Int           @default(0)
  guardianChecks  Json?         // { forbiddenWords: bool, maturityBand: bool, sources: bool, disclaimer: bool, yieldPromise: bool, brandVoice: bool }
  guardianFlags   Json?         // Array of flagged issues

  // Predictive analytics
  predictedEngagement Float?
  predictedReach      Int?
  predictedSignups    Int?

  // Attribution
  impressions     Int           @default(0)
  engagements     Int           @default(0)
  signups         Int           @default(0)
  integrations    Int           @default(0)
  treasuryImpact  Float         @default(0)

  // Scheduling
  scheduledAt     DateTime?
  publishedAt     DateTime?

  // Versioning
  version         Int           @default(1)
  parentId        String?

  // Relations
  authorId        String
  author          User              @relation(fields: [authorId], references: [id])
  approvals       Approval[]
  campaign        Campaign?         @relation(fields: [campaignId], references: [id])
  revisions       ContentRevision[]
  bridgeJobs      N8nBridgeJob[]
  publishReceipts PublishReceipt[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([n8nWorkflowId])
  @@index([n8nExecutionId])
  @@map("contents")
}

model ContentRevision {
  id                    String         @id @default(cuid())
  contentId             String
  content               Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version               Int
  title                 String
  body                  String         @db.Text
  channel               Channel
  type                  ContentType
  contentHash           String
  guardianPolicyVersion String
  guardianScore         Int
  guardianResult        GuardianResult
  guardianChecks        Json?
  guardianFlags         Json?
  createdById           String
  createdBy             User           @relation(fields: [createdById], references: [id])
  createdAt             DateTime       @default(now())

  approvals       Approval[]
  publishReceipts PublishReceipt[]

  @@unique([contentId, version])
  @@map("content_revisions")
}

model Approval {
  id          String          @id @default(cuid())
  contentId   String
  content     Content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  revisionId  String
  revision    ContentRevision @relation(fields: [revisionId], references: [id])
  reviewerId  String
  reviewer    User            @relation(fields: [reviewerId], references: [id])
  status      ApprovalStatus
  comment     String?
  createdAt   DateTime        @default(now())

  @@map("approvals")
}

model Campaign {
  id            String          @id @default(cuid())
  name          String
  theme         CampaignTheme
  audience      AudienceTier
  status        CampaignStatus  @default(PLANNING)
  startDate     DateTime
  endDate       DateTime?
  budget        Float?

  // Attribution
  totalImpressions  Int         @default(0)
  totalEngagements  Int         @default(0)
  totalSignups      Int         @default(0)
  totalIntegrations Int         @default(0)

  contents      Content[]
  creatorId     String
  creator       User            @relation(fields: [creatorId], references: [id])

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("campaigns")
}

model Agent {
  id            String      @id @default(cuid())
  name          String      @unique
  type          AgentType
  status        AgentStatus @default(OFFLINE)
  config        Json        // Agent-specific configuration
  metrics       Json?       // { tasksCompleted, successRate, avgLatency }
  lastRunAt     DateTime?

  // MCP Server connection
  mcpEndpoint   String?
  mcpStatus     McpStatus   @default(DISCONNECTED)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("agents")
}

model ActivityLog {
  id          String        @id @default(cuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  agentId     String?
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime      @default(now())

  @@map("activity_logs")
}

model GuardianRule {
  id          String       @id @default(cuid())
  type        RuleType
  pattern     String       // Regex or keyword
  severity    RuleSeverity
  action      RuleAction   @default(REVIEW)
  message     String
  autoBlock   Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@map("guardian_rules")
}

model Integration {
  id            String          @id @default(cuid())
  name          String          @unique
  type          IntegrationType
  status        IntegrationStatus @default(DISCONNECTED)
  credentials   Json?           // Encrypted credentials
  config        Json?           // Integration-specific config
  lastSyncAt    DateTime?
  errorCount    Int             @default(0)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("integrations")
}

model N8nBridgeJob {
  id                 String       @id @default(cuid())
  eventId            String       @unique
  externalDraftId    String
  contentId          String
  content            Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  workflowId         String
  executionId        String
  resumeUrlEncrypted String       @db.Text
  resumeExpiresAt    DateTime?
  resumeStatus       ResumeStatus @default(PENDING)
  attemptCount       Int          @default(0)
  lastAttemptAt      DateTime?
  nextAttemptAt      DateTime?
  lastError          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([externalDraftId])
  @@index([resumeStatus, nextAttemptAt])
  @@map("n8n_bridge_jobs")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  type          String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateId])
  @@map("outbox_events")
}

model PublishReceipt {
  id             String        @id @default(cuid())
  eventId        String        @unique
  contentId      String
  content        Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  revisionId     String
  revision       ContentRevision @relation(fields: [revisionId], references: [id])
  contentHash    String
  channel        Channel
  platformPostId String?
  platformUrl    String?
  status         PublishStatus
  publishedAt    DateTime?
  errorCode      String?
  errorMessage   String?
  n8nExecutionId String?
  rawMetadata    Json?
  createdAt      DateTime      @default(now())

  @@index([contentId])
  @@map("publish_receipts")
}

// Enums
enum UserRole {
  ADMIN
  MANAGER
  REVIEWER
  EDITOR
  VIEWER
  SERVICE
}

enum ContentType {
  TWITTER_THREAD
  BLOG_POST
  EMAIL
  PRESS_RELEASE
  AD_CREATIVE
  VIDEO_SCRIPT
  LINKEDIN_POST
  DISCORD_MESSAGE
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentOrigin {
  MANUAL
  N8N
}

enum ContentRiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GuardianResult {
  ALLOW
  REVIEW
  BLOCK
}

enum Channel {
  TWITTER
  LINKEDIN
  DISCORD
  EMAIL
  BLOG
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum CampaignTheme {
  CONTROL_PLANE
  BUILD_AGENTS
  COMPLIANT_ARCHITECTURE
  THE_FLYWHEEL
  CUSTOM
}

enum AudienceTier {
  TIER_1_AGENTS
  TIER_2_DEFI
  TIER_3_INFRASTRUCTURE
  TIER_4_ENTERPRISE
  ALL
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum AgentType {
  CREATOR
  PUBLISHER
  ANALYZER
  GUARDIAN
}

enum AgentStatus {
  ONLINE
  OFFLINE
  BUSY
  ERROR
}

enum McpStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ActivityType {
  CONTENT_CREATED
  CONTENT_UPDATED
  CONTENT_APPROVED
  CONTENT_REJECTED
  CONTENT_PUBLISHED
  AGENT_STARTED
  AGENT_STOPPED
  AGENT_ERROR
  CAMPAIGN_LAUNCHED
  INTEGRATION_CONNECTED
  INTEGRATION_ERROR
  USER_LOGIN
  SETTINGS_CHANGED
}

enum RuleType {
  FORBIDDEN_WORD
  REQUIRED_LABEL
  YIELD_PROMISE
  REGULATORY_TERM
  BRAND_VOICE
  MATURITY_BAND
}

enum RuleSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum RuleAction {
  ALLOW
  REVIEW
  BLOCK
}

enum ResumeStatus {
  PENDING
  DELIVERED
  EXPIRED
  FAILED
}

enum OutboxStatus {
  PENDING
  RETRY
  PROCESSED
  FAILED
}

enum PublishStatus {
  SUCCESS
  FAILED
}

enum IntegrationType {
  TWITTER
  LINKEDIN
  DISCORD
  MAILCHIMP
  GITHUB
  FIREBASE
  N8N
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNCING
}
